# Renderer/API configuration. Do not put production secrets in frontend variables.
VITE_API_URL=http://127.0.0.1:3000

# Future backend configuration for Base44-independent deployment.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/salon_management
AUTH_SECRET=replace-with-a-long-random-secret
BASE44_EXPORT_DIR=./base44-export
